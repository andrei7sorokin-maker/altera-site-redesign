---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SpecialCourseLanding from "@/components/pages/SpecialCourseLanding.astro";
import { getSpecialCourse } from "@/data/additionalCourses";

const content = getSpecialCourse("et", "nightDriving").page;
---

<BaseLayout locale="et" title={content.seoTitle} description={content.seoDescription}>
  <SpecialCourseLanding content={content} locale="et" />
</BaseLayout>
