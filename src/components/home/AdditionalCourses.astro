---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { additionalCourseSectionCopy, additionalCourses } from "@/data/additionalCourses";
import type { Locale } from "@/data/locales";

const { locale = "et" } = Astro.props as { locale?: Locale };
const copy = additionalCourseSectionCopy[locale];
const courses = additionalCourses[locale];
---

<section class="section useful-courses-section" id="useful-courses">
  <Container>
    <div class="useful-courses-heading">
      <div>
        <div class="eyebrow">{copy.eyebrow}</div>
        <h2 class="section-title">{copy.title}</h2>
      </div>
      <p class="section-text">{copy.text}</p>
    </div>

    <div class="useful-courses-grid">
      {courses.map((course) => (
        <article class={`useful-course-card useful-course-card--${course.key}`}>
          <div class="useful-course-card__media" aria-hidden="true">
            <span class="useful-course-card__number">{course.shortLabel}</span>
            <span class="useful-course-card__play"></span>
            <strong>{course.mediaLabel}</strong>
            <small>{course.videoStatus}</small>
          </div>
          <div class="useful-course-card__body">
            <div class="eyebrow">{course.eyebrow}</div>
            <h3>{course.title}</h3>
            <p>{course.text}</p>
            <div class="useful-course-card__meta">
              {course.meta.map((item) => <span>{item}</span>)}
            </div>
            <Button href={course.href} variant="secondary">{copy.buttonLabel}</Button>
          </div>
        </article>
      ))}
    </div>
    <p class="useful-courses-note">{copy.videoNote}</p>
  </Container>
</section>

<style>
  .useful-courses-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(260px, 0.9fr);
    gap: 36px;
    align-items: end;
    margin-bottom: 24px;
  }

  .useful-courses-heading .section-title {
    margin-bottom: 0;
  }

  .useful-courses-heading .section-text {
    max-width: 54ch;
    margin-bottom: 2px;
    line-height: 1.65;
  }

  .useful-courses-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .useful-course-card {
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 26px;
    background: #fff;
    box-shadow: var(--shadow-soft);
  }

  .useful-course-card__media {
    position: relative;
    display: grid;
    min-height: 174px;
    align-content: end;
    gap: 4px;
    padding: 22px;
    overflow: hidden;
    color: #fff;
    background: linear-gradient(145deg, #102a57, #3e7fc0);
  }

  .useful-course-card__media::after {
    content: "";
    position: absolute;
    width: 180px;
    height: 180px;
    right: -50px;
    top: -70px;
    border: 1px solid rgba(255,255,255,0.2);
    border-radius: 50%;
    box-shadow: 0 0 0 22px rgba(255,255,255,0.04), 0 0 0 44px rgba(255,255,255,0.03);
  }

  .useful-course-card--firstAid .useful-course-card__media {
    background: linear-gradient(145deg, #a93652, #c6536d);
  }

  .useful-course-card--slipperyDriving .useful-course-card__media {
    background: linear-gradient(145deg, #173d7a, #2e5fa8);
  }

  .useful-course-card__number {
    position: absolute;
    top: 18px;
    left: 22px;
    color: rgba(255,255,255,0.68);
    font-size: 0.82rem;
    font-weight: 900;
    letter-spacing: 0.12em;
  }

  .useful-course-card__play {
    position: absolute;
    top: 50%;
    right: 24px;
    display: grid;
    width: 48px;
    height: 48px;
    transform: translateY(-50%);
    place-items: center;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
  }

  .useful-course-card__play::after {
    content: "";
    display: block;
    margin-left: 3px;
    border-top: 7px solid transparent;
    border-bottom: 7px solid transparent;
    border-left: 10px solid #fff;
  }

  .useful-course-card__media strong,
  .useful-course-card__media small {
    position: relative;
    z-index: 1;
  }

  .useful-course-card__media strong {
    font-size: 1.1rem;
  }

  .useful-course-card__media small {
    color: rgba(255,255,255,0.72);
  }

  .useful-course-card__body {
    display: grid;
    gap: 12px;
    padding: 22px;
  }

  .useful-course-card__body h3 {
    margin: 0;
    color: var(--color-navy-strong);
    font-size: 1.35rem;
    line-height: 1.08;
  }

  .useful-course-card__body p {
    min-height: 68px;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  .useful-course-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .useful-course-card__meta span {
    padding: 7px 10px;
    border-radius: 999px;
    color: var(--color-navy);
    background: #f1f6fb;
    font-size: 0.82rem;
    font-weight: 700;
  }

  .useful-course-card .button {
    justify-self: start;
    margin-top: 4px;
  }

  .useful-courses-note {
    margin: 18px 0 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .useful-courses-heading,
    .useful-courses-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .useful-course-card__body p {
      min-height: 0;
    }
  }
</style>
