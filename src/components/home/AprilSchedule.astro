---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import type { Locale } from "@/data/locales";
import { categoryCards, type CategoryKey } from "@/data/categories";
import { getRollingCourseSchedule, scheduleCopy } from "@/data/courseSchedule";

const { locale = "et" } = Astro.props as { locale?: Locale };
const months = getRollingCourseSchedule(locale);
const t = scheduleCopy[locale];
const categoryImages = new Map(categoryCards[locale].map((category) => [category.key, category.image]));

const getCategoryHref = (category: string, locale: Locale) => {
  const slug = category.toLowerCase();
  const etRoutes = {
    am: "/am-kategooria-tallinnas/",
    a: "/a-kategooria-tallinnas/",
    b: "/b-kategooria-tallinnas/",
    be: "/be-kategooria-tallinnas/",
  } as const;
  const ruRoutes = {
    am: "/ru/am-kategooria-tallinnas/",
    a: "/ru/a-kategooria-tallinnas/",
    b: "/ru/b-kategooria-tallinnas/",
    be: "/ru/be-kategooria-tallinnas/",
  } as const;
  const enRoutes = {
    am: "/en/am-kategooria-tallinnas/",
    a: "/en/a-kategooria-tallinnas/",
    b: "/en/b-kategooria-tallinnas/",
    be: "/en/be-kategooria-tallinnas/",
  } as const;

  if (locale === "ru") return ruRoutes[slug as keyof typeof ruRoutes] ?? `/ru/${slug}-kategooria-tallinnas/`;
  if (locale === "en") return enRoutes[slug as keyof typeof enRoutes] ?? `/en/${slug}-kategooria-tallinnas/`;
  return etRoutes[slug as keyof typeof etRoutes] ?? `/${slug}-kategooria-tallinnas/`;
};

const registrationHref = locale === "et" ? "/#registration" : `/${locale}/#registration`;
---

<section class="section" id="schedule">
  <Container>
    <div class="schedule-shell" data-course-schedule data-locale={locale}>
      <div class="section-shell">
        <div class="eyebrow">{t.eyebrow}</div>
      </div>
      <div class="schedule-tabs" aria-label="Schedule months">
        {months.map((month, index) => (
          <a
            class={`schedule-tab ${index === 1 ? "schedule-tab--default" : ""}`}
            href={`#schedule-${month.slot}`}
            data-schedule-month-label={index}
          >
            {month.monthLabel}
          </a>
        ))}
      </div>
      <div class="schedule-panels">
        {months.map((month, index) => (
            <div
              class={`schedule-panel ${index === 1 ? "schedule-panel--default" : ""}`}
              id={`schedule-${month.slot}`}
              data-schedule-panel={month.slot}
              data-schedule-month={index}
            >
              <div class="schedule-header">
                <strong data-schedule-panel-title>{month.monthLabel}</strong>
              </div>
              <div class="schedule-table">
                {month.rows.map((row, rowIndex) => (
                  <article class={`schedule-row schedule-row--${row.category.toLowerCase()}`}>
                    <a class="schedule-row__category" href={getCategoryHref(row.category, locale)}>{row.category}</a>
                    <div class="schedule-cell">
                      <span class="schedule-label">{t.date}</span>
                      <strong class="schedule-value" data-schedule-date={rowIndex}>{row.date}</strong>
                    </div>
                    <div class="schedule-row__vehicle">
                      <img
                        src={categoryImages.get(row.category.toLowerCase() as CategoryKey) ?? row.image}
                        alt={`${row.category} category`}
                        class={`schedule-vehicle schedule-vehicle--${row.category.toLowerCase()}`}
                      />
                    </div>
                    <div class="schedule-cell">
                      <span class="schedule-label">{t.format}</span>
                      <strong class="schedule-value">{row.format}</strong>
                    </div>
                    <div class="schedule-cell">
                      <span class="schedule-label">{t.language}</span>
                      <strong class="schedule-value schedule-value--meta">{row.language}</strong>
                    </div>
                    <div class="schedule-row__action">
                      <Button href={registrationHref}>{t.register}</Button>
                    </div>
                  </article>
                ))}
              </div>
            </div>
        ))}
      </div>
    </div>
  </Container>
</section>

<script>
  import { getRollingCourseSchedule } from "@/data/courseSchedule";

  document.querySelectorAll<HTMLElement>("[data-course-schedule]").forEach((root) => {
    const locale = root.dataset.locale as "et" | "ru" | "en";
    const months = getRollingCourseSchedule(locale);

    root.querySelectorAll<HTMLElement>("[data-schedule-month-label]").forEach((tab) => {
      const index = Number(tab.dataset.scheduleMonthLabel);
      tab.textContent = months[index]?.monthLabel ?? tab.textContent;
    });

    root.querySelectorAll<HTMLElement>("[data-schedule-month]").forEach((panel) => {
      const index = Number(panel.dataset.scheduleMonth);
      const month = months[index];
      if (!month) return;

      const title = panel.querySelector<HTMLElement>("[data-schedule-panel-title]");
      if (title) title.textContent = month.monthLabel;
      panel.querySelectorAll<HTMLElement>("[data-schedule-date]").forEach((date) => {
        const rowIndex = Number(date.dataset.scheduleDate);
        date.textContent = month.rows[rowIndex]?.date ?? date.textContent;
      });
    });
  });
</script>
