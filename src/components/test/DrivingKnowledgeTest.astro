---
import Button from "@/components/ui/Button.astro";
import { drivingTestConfig, drivingTestQuestions } from "@/data/drivingTest";
---

<section class="section test-stage">
  <div class="container">
    {
      drivingTestConfig.isPublished ? (
        <div class="test-app" data-driving-test>
          <script type="application/json" data-test-data set:html={JSON.stringify(drivingTestQuestions)} />

          <div class="test-screen test-intro" data-test-screen="intro">
            <span class="test-kicker">Мини-тест Altera</span>
            <h2>Готовы проверить себя?</h2>
            <p>
              Отвечайте спокойно: после каждого вопроса появится объяснение, а в конце — общий результат и темы,
              которые полезно повторить.
            </p>
            <div class="test-meta">
              <span>{drivingTestQuestions.length} вопросов</span>
              <span>Около {drivingTestConfig.estimatedMinutes} минут</span>
              <span>Без регистрации</span>
            </div>
            <button class="button button-primary test-action" type="button" data-test-start>Начать тест</button>
          </div>

          <div class="test-screen" data-test-screen="question" hidden>
            <div class="test-progress-row">
              <span data-test-counter>Вопрос 1</span>
              <span data-test-score>0 правильных</span>
            </div>
            <div class="test-progress" aria-hidden="true"><span data-test-progress></span></div>
            <div class="test-question-media" data-test-media hidden>
              <img data-test-image alt="" />
            </div>
            <h2 class="test-question" data-test-question></h2>
            <div class="test-options" data-test-options></div>
            <div class="test-feedback" data-test-feedback hidden aria-live="polite">
              <strong data-test-feedback-title></strong>
              <p data-test-explanation></p>
            </div>
            <button class="button button-primary test-action" type="button" data-test-next hidden>Следующий вопрос</button>
          </div>

          <div class="test-screen test-result" data-test-screen="result" hidden>
            <span class="test-kicker">Тест завершён</span>
            <div class="test-result__score"><strong data-test-result-score>0 / 0</strong></div>
            <h2 data-test-result-title>Ваш результат</h2>
            <p data-test-result-message></p>
            <div class="button-row test-result__actions">
              <Button href="/ru/#registration">Записаться на курс</Button>
              <button class="button button-secondary test-action" type="button" data-test-restart>Пройти ещё раз</button>
            </div>
          </div>
        </div>
      ) : (
        <div class="test-draft">
          <div class="test-draft__content">
            <span class="test-kicker">Тест готовится</span>
            <h2>Интерфейс уже готов — осталось добавить вопросы</h2>
            <p>
              Здесь появятся {drivingTestConfig.expectedQuestionCount} вопросов с вариантами ответов, короткими
              объяснениями и итоговым результатом. До запуска мы проверим каждую формулировку и правильный ответ.
            </p>
            <div class="test-meta">
              <span>Один вопрос за раз</span>
              <span>Объяснение после ответа</span>
              <span>Результат без регистрации</span>
            </div>
            <Button href="/ru/">Вернуться на главную</Button>
          </div>

          <div class="test-draft__preview" aria-hidden="true">
            <div class="test-progress-row">
              <span>Вопрос 01 / 10</span>
              <span>Пример экрана</span>
            </div>
            <div class="test-progress"><span style="width: 10%"></span></div>
            <div class="test-draft__question">Здесь будет вопрос ученику</div>
            <div class="test-draft__option"><span>A</span><i></i></div>
            <div class="test-draft__option"><span>B</span><i></i></div>
            <div class="test-draft__option"><span>C</span><i></i></div>
          </div>
        </div>
      )
    }
  </div>
</section>

{
  drivingTestConfig.isPublished && (
    <script>
      type TestQuestion = {
        id: string;
        question: string;
        options: Array<{ id: string; text: string }>;
        correctOptionId: string;
        explanation: string;
        image?: string;
        imageAlt?: string;
      };

      document.querySelectorAll<HTMLElement>("[data-driving-test]").forEach((root) => {
        const dataElement = root.querySelector<HTMLScriptElement>("[data-test-data]");
        const questions = JSON.parse(dataElement?.textContent || "[]") as TestQuestion[];
        if (!questions.length) return;

        const screens = Array.from(root.querySelectorAll<HTMLElement>("[data-test-screen]"));
        const counter = root.querySelector<HTMLElement>("[data-test-counter]");
        const scoreLabel = root.querySelector<HTMLElement>("[data-test-score]");
        const progress = root.querySelector<HTMLElement>("[data-test-progress]");
        const questionText = root.querySelector<HTMLElement>("[data-test-question]");
        const optionsRoot = root.querySelector<HTMLElement>("[data-test-options]");
        const feedback = root.querySelector<HTMLElement>("[data-test-feedback]");
        const feedbackTitle = root.querySelector<HTMLElement>("[data-test-feedback-title]");
        const explanation = root.querySelector<HTMLElement>("[data-test-explanation]");
        const nextButton = root.querySelector<HTMLButtonElement>("[data-test-next]");
        const media = root.querySelector<HTMLElement>("[data-test-media]");
        const image = root.querySelector<HTMLImageElement>("[data-test-image]");
        const resultScore = root.querySelector<HTMLElement>("[data-test-result-score]");
        const resultTitle = root.querySelector<HTMLElement>("[data-test-result-title]");
        const resultMessage = root.querySelector<HTMLElement>("[data-test-result-message]");

        let currentIndex = 0;
        let score = 0;

        const showScreen = (name: string) => {
          screens.forEach((screen) => {
            screen.hidden = screen.dataset.testScreen !== name;
          });
        };

        const renderQuestion = () => {
          const item = questions[currentIndex];
          if (!item || !optionsRoot || !questionText) return;

          if (counter) counter.textContent = `Вопрос ${currentIndex + 1} / ${questions.length}`;
          if (scoreLabel) scoreLabel.textContent = `${score} правильных`;
          if (progress) progress.style.width = `${((currentIndex + 1) / questions.length) * 100}%`;
          questionText.textContent = item.question;
          optionsRoot.replaceChildren();

          if (feedback) feedback.hidden = true;
          if (nextButton) nextButton.hidden = true;

          if (item.image && image && media) {
            image.src = item.image;
            image.alt = item.imageAlt || "Иллюстрация к вопросу";
            media.hidden = false;
          } else if (media) {
            media.hidden = true;
          }

          item.options.forEach((option, optionIndex) => {
            const button = document.createElement("button");
            button.type = "button";
            button.className = "test-option";
            button.dataset.answerId = option.id;
            button.innerHTML = `<span>${String.fromCharCode(65 + optionIndex)}</span><strong></strong>`;
            const label = button.querySelector("strong");
            if (label) label.textContent = option.text;

            button.addEventListener("click", () => {
              const answerButtons = Array.from(optionsRoot.querySelectorAll<HTMLButtonElement>(".test-option"));
              const isCorrect = option.id === item.correctOptionId;
              if (isCorrect) score += 1;

              answerButtons.forEach((answerButton) => {
                answerButton.disabled = true;
                if (answerButton.dataset.answerId === item.correctOptionId) answerButton.classList.add("is-correct");
              });

              if (!isCorrect) button.classList.add("is-wrong");
              if (feedback) {
                feedback.hidden = false;
                feedback.classList.toggle("is-correct", isCorrect);
              }
              if (feedbackTitle) feedbackTitle.textContent = isCorrect ? "Верно" : "Почти. Посмотрите объяснение";
              if (explanation) explanation.textContent = item.explanation;
              if (scoreLabel) scoreLabel.textContent = `${score} правильных`;
              if (nextButton) {
                nextButton.hidden = false;
                nextButton.textContent = currentIndex === questions.length - 1 ? "Показать результат" : "Следующий вопрос";
                nextButton.focus();
              }
            });

            optionsRoot.append(button);
          });
        };

        const showResult = () => {
          const percentage = Math.round((score / questions.length) * 100);
          if (resultScore) resultScore.textContent = `${score} / ${questions.length}`;

          if (percentage >= 80) {
            if (resultTitle) resultTitle.textContent = "Отличная готовность";
            if (resultMessage) resultMessage.textContent = "У вас уверенная база. Продолжайте в том же темпе и переходите к системной подготовке.";
          } else if (percentage >= 50) {
            if (resultTitle) resultTitle.textContent = "Хорошая база";
            if (resultMessage) resultMessage.textContent = "Основы уже знакомы. Несколько тем стоит повторить, чтобы чувствовать себя увереннее.";
          } else {
            if (resultTitle) resultTitle.textContent = "Есть что освежить";
            if (resultMessage) resultMessage.textContent = "Это нормальная точка старта. На курсе мы разберём правила последовательно и без лишнего стресса.";
          }

          showScreen("result");
        };

        root.querySelector<HTMLButtonElement>("[data-test-start]")?.addEventListener("click", () => {
          currentIndex = 0;
          score = 0;
          showScreen("question");
          renderQuestion();
        });

        nextButton?.addEventListener("click", () => {
          if (currentIndex >= questions.length - 1) {
            showResult();
            return;
          }

          currentIndex += 1;
          renderQuestion();
        });

        root.querySelector<HTMLButtonElement>("[data-test-restart]")?.addEventListener("click", () => {
          currentIndex = 0;
          score = 0;
          showScreen("question");
          renderQuestion();
        });
      });
    </script>
  )
}

<style>
  .test-stage {
    padding-top: 18px;
  }

  .test-app,
  .test-draft {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(16, 42, 87, 0.1);
    border-radius: 32px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-soft);
  }

  .test-screen {
    display: grid;
    gap: 22px;
    max-width: 820px;
    margin: 0 auto;
    padding: clamp(28px, 6vw, 64px);
  }

  .test-screen[hidden] {
    display: none;
  }

  .test-intro,
  .test-result {
    justify-items: start;
  }

  .test-kicker {
    color: var(--color-sky);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--color-navy-strong);
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.04em;
  }

  p {
    max-width: 64ch;
    margin: 0;
    color: var(--color-muted);
    font-size: 1.03rem;
    line-height: 1.65;
  }

  .test-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .test-meta span {
    padding: 9px 12px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-navy);
    background: var(--color-surface-soft);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .test-action {
    cursor: pointer;
    font: inherit;
  }

  .test-progress-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    color: var(--color-muted);
    font-size: 0.9rem;
    font-weight: 700;
  }

  .test-progress {
    width: 100%;
    height: 9px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--color-surface-soft);
  }

  .test-progress span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--color-sky), #6ba8df);
    transition: width 0.35s ease;
  }

  .test-question-media {
    overflow: hidden;
    max-height: 330px;
    border-radius: 22px;
    background: var(--color-surface-soft);
  }

  .test-question-media[hidden] {
    display: none;
  }

  .test-question-media img {
    width: 100%;
    height: 100%;
    max-height: 330px;
    object-fit: contain;
  }

  .test-question {
    font-size: clamp(1.55rem, 3vw, 2.3rem);
    line-height: 1.15;
  }

  .test-options {
    display: grid;
    gap: 12px;
  }

  :global(.test-option) {
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 14px;
    align-items: center;
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--color-line);
    border-radius: 17px;
    color: var(--color-text);
    background: #fff;
    cursor: pointer;
    font: inherit;
    text-align: left;
    transition: border-color 0.18s ease, transform 0.18s ease, background 0.18s ease;
  }

  :global(.test-option:hover:not(:disabled)) {
    transform: translateY(-1px);
    border-color: var(--color-sky);
  }

  :global(.test-option span) {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    color: var(--color-navy);
    background: var(--color-surface-soft);
    font-weight: 900;
  }

  :global(.test-option strong) {
    line-height: 1.45;
  }

  :global(.test-option.is-correct) {
    border-color: #45966c;
    background: #eef9f3;
  }

  :global(.test-option.is-wrong) {
    border-color: var(--color-red-strong);
    background: #fff1f3;
  }

  .test-feedback {
    display: grid;
    gap: 7px;
    padding: 17px 18px;
    border-left: 4px solid var(--color-red-strong);
    border-radius: 14px;
    background: #fff2f4;
  }

  .test-feedback[hidden] {
    display: none;
  }

  .test-feedback.is-correct {
    border-left-color: #45966c;
    background: #eef9f3;
  }

  .test-feedback strong {
    color: var(--color-navy-strong);
  }

  .test-feedback p {
    font-size: 0.96rem;
  }

  .test-result__score {
    display: grid;
    place-items: center;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(145deg, var(--color-navy), var(--color-sky));
    box-shadow: 0 22px 50px rgba(16, 42, 87, 0.22);
  }

  .test-result__score strong {
    font-size: 2rem;
  }

  .test-result__actions {
    margin-top: 6px;
  }

  .test-draft {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.78fr);
    gap: 34px;
    align-items: center;
    padding: clamp(28px, 5vw, 56px);
  }

  .test-draft__content {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .test-draft__preview {
    display: grid;
    gap: 16px;
    padding: 24px;
    border: 1px solid rgba(16, 42, 87, 0.12);
    border-radius: 25px;
    background: linear-gradient(180deg, #f8fbff, #edf4fb);
    transform: rotate(1.3deg);
  }

  .test-draft__question {
    padding: 18px;
    border-radius: 16px;
    color: var(--color-navy-strong);
    background: #fff;
    font-size: 1.15rem;
    font-weight: 800;
  }

  .test-draft__option {
    display: grid;
    grid-template-columns: 38px 1fr;
    gap: 12px;
    align-items: center;
  }

  .test-draft__option span {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 11px;
    color: var(--color-navy);
    background: #fff;
    font-weight: 900;
  }

  .test-draft__option i {
    display: block;
    width: 100%;
    height: 12px;
    border-radius: 999px;
    background: rgba(16, 42, 87, 0.12);
  }

  @media (max-width: 800px) {
    .test-draft {
      grid-template-columns: 1fr;
    }

    .test-draft__preview {
      transform: none;
    }
  }

  @media (max-width: 520px) {
    .test-screen,
    .test-draft {
      padding: 24px;
    }

    .test-app,
    .test-draft {
      border-radius: 24px;
    }

    .test-progress-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
